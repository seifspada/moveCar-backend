generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================



enum StatutAdherent {
  ACTIF
  SUSPENDU
  RESILIE
}

enum TypePack {
  premium
  basic
}

// ====================Partenaire======================

enum StatutEntreprise {
  DIRECTEUR_GENERAL
  DIRECTEUR
  MANAGER
  RESPONSABLE_TRANSPORT
  RESPONSABLE_LOGISTIQUE
  CHEF_ENTREPRISE
  AUTRE

  @@map("statut_entreprise")
}

enum StatutDemande {
  EN_ATTENTE
  EN_COURS_TRAITEMENT
  VALIDEE
  ACCEPTEE
  REFUSEE
  ANNULEE

  @@map("statut_demande")
}

enum TypeRendezvous {
  TELEPHONIQUE
  PHYSIQUE

  @@map("type_rendezvous")
}

enum StatutRendezvous {
  PLANIFIE
  CONFIRME
  EN_COURS
  TERMINE
  ANNULE
  REPORTE

  @@map("statut_rendezvous")
}

enum ResultatRendezvous {
  INTERESSE
  A_RECONTACTER
  NON_INTERESSE
  CONTRAT_SIGNE

  @@map("resultat_rendezvous")
}

enum TypeReservation {
  RENDEZ_VOUS
  CONGE
  JOUR_FERIE
  EVENEMENT_INTERNE
  AUTRE

  @@map("type_reservation")
}
enum StatutSession {
  EN_COURS
  TERMINEE

  @@map("statut_session")
}
enum StatutReservation {
  EN_ATTENTE
  ACCEPTED_BY_AGENT // ← nouveau
  CONFIRMED_BY_ADHERENT // ← nouveau (remplace CONFIRMEE)
  ANNULATION_DEMANDEE // ✅ nouveau
  ANNULEE
  REFUSEE
}

enum TypeAlerte {
  GEOGRAPHIQUE // Type 1 : 1 Ville + Rayon
  TRAJET // Type 2 : 2 Villes + Rayon commun
}

// ==================== GESTION DES PHOTOS DE SESSION ====================

enum EtapeSession {
  PRE_DEPART       // Photos avant la mission
  POST_LIVRAISON   // Photos après la livraison

  @@map("etape_session")
}
enum IncidentType {
  DÉVIATION_GPS           // Sortie de zone autorisée
  VITESSE_EXCESSIVE       // Vitesse > limite
  ARRÊT_PROLONGÉ          // Arrêt > X minutes
  DÉTOUR_INJUSTIFIÉ       // Détour détecté
  ANOMALIE_CARBURANT      // Consommation anormale
}
enum TypeMediaSession {
  // ──── PRÉ-DÉPART (véhicule avant mission) ────
  PHOTO_AVANT
  PHOTO_ARRIERE
  PHOTO_GAUCHE
  PHOTO_DROIT
  PHOTO_INTERIEUR
  PHOTO_TABLEAU_BORD
  PHOTO_CARBURANT
  DEGATS_PRE_MISSION

  // ──── DOCUMENTS ────
  PERMIS_RECTO_CONDUCTEUR
  PERMIS_VERSO_CONDUCTEUR

  // ──── POST-LIVRAISON (véhicule après mission) ────
  PHOTO_AVANT_FINAL
  PHOTO_ARRIERE_FINAL
  PHOTO_GAUCHE_FINAL
  PHOTO_DROIT_FINAL
  PHOTO_INTERIEUR_FINAL
  PHOTO_TABLEAU_BORD_FINAL
  CARBURANT_FINAL
  DEGATS_POST_MISSION
  PREUVE_LIVRAISON
  SIGNATURE_CLIENT

  @@map("type_media_session")
}

// ==================== FICHE TECHNIQUE PRÉ-MISSION ====================

enum StatutPreTripInspection {
  DRAFT // Créée mais aucune photo encore
  IN_PROGRESS // Au moins une photo uploadée, pas encore complète
  COMPLETED // Toutes les photos + consentement présents
  VALIDATED // Validé automatiquement par le backend (anti-fraude OK)
  REJECTED // Rejeté (anti-fraude a détecté un problème)

  @@map("statut_pretrip_inspection")
}

enum EtapeInspection {
  EXTERIEUR
  INTERIEUR
  TABLEAU_BORD
  DOCUMENTS
  IDENTITE
  CONDITIONS
  TERMINEE

  @@map("etape_inspection")
}

enum TypeMediaInspection {
  // Étape 1 : Extérieur
  EXT_FACE_AVANT
  EXT_FACE_ARRIERE
  EXT_COTE_GAUCHE
  EXT_COTE_DROIT

  // Étape 2 : Intérieur
  INT_SIEGE_CONDUCTEUR
  INT_SIEGE_PASSAGER
  INT_BANQUETTE_ARRIERE
  INT_VUE_GLOBALE

  // Étape 3 : Tableau de bord
  TABLEAU_BORD

  // Étape 4 : Documents
  PERMIS_RECTO
  PERMIS_VERSO

  // Étape 5 : Identité
  SELFIE_VEHICULE

  @@map("type_media_inspection")
}

// ==================== UTILISATEURS SYSTÈME ====================

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id                   Int       @id @default(autoincrement())
  name                 String    @db.VarChar(100)
  email                String    @unique @db.VarChar(255)
  password             String?
  photo                String?   @default("/default-avatar.png")
  roleId               Int
  role                 Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  isActive             Boolean   @default(true)

  adherent   Adherent?
  partenaire Partenaire?
  agent      Agent?
  admin      Admin?

  alertes               AlerteGeographique[]
  historiqueAnnulations HistoriqueAnnulation[] // ✅ ajouter cette ligne

  @@index([roleId])
  @@index([email])
  @@map("users")
}

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom      String @db.VarChar(100)
  email    String @unique @db.VarChar(255)
  password String

  @@index([userId])
  @@index([email])
  @@map("admins")
}

// ==================== DEMANDES D'ADHÉSION ====================

model DemandeAdhesion {
  id Int @id @default(autoincrement())

  // Informations personnelles
  nom           String   @db.VarChar(100)
  prenom        String   @db.VarChar(100)
  dateNaissance DateTime @db.Date
  email         String   @unique @db.VarChar(255)
  telephone     String   @db.VarChar(20)
  adresse       String   @db.Text
  ville         String   @db.VarChar(100)

  // Informations professionnelles
  raisonSociale String @db.VarChar(255)
  numeroKbis    String @db.VarChar(50)

  profileToken       String?   @unique
  profileTokenExpiry DateTime?

  // Gestion du statut
  statut     StatutDemande @default(EN_ATTENTE)
  motifRefus String?       @db.Text // ✅ AJOUTER ICI

  // Traçabilité
  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt

  // Relations
  documents Document[]
  adherent  Adherent[]

  @@index([statut])
  @@index([email])
  @@index([dateCreation])
  @@index([profileToken])
  @@map("demandes_adhesion")
}

model Adherent {
  id Int @id @default(autoincrement())

  // Relation avec User (authentification)
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Informations personnelles
  nom            String    @db.VarChar(100)
  prenom         String    @db.VarChar(100)
  numeroAdherent String?   @unique @db.VarChar(50) // ✅ AJOUTER CE CHAMP
  dateNaissance  DateTime? @db.Date // ✅ AJOUTER CE CHAMP
  telephone      String    @db.VarChar(20)
  adresse        String?   @db.Text // ✅ AJOUTER CE CHAMP
  codePostal     String?   @db.VarChar(10) // ✅ AJOUTER CE CHAMP
  ville          String    @db.VarChar(100)

  // Informations professionnelles
  raisonSociale String @db.VarChar(255)
  numeroKbis    String @db.VarChar(50)

  // Profil adhérent
  typePack TypePack       @default(basic)
  statut   StatutAdherent @default(ACTIF)
  photoUrl String?        @db.VarChar(500)

  // Gestion du blocage
  estBloque     Boolean   @default(false)
  raisonBlocage String?   @db.Text
  dateBlocage   DateTime?

  // Gestion cotisation
  dateAdhesion      DateTime  @default(now())
  dateExpiration    DateTime?
  montantCotisation Decimal?  @db.Decimal(10, 2)

  // Relation avec la demande d'origine
  demandeAdhesionId Int
  demandeAdhesion   DemandeAdhesion @relation(fields: [demandeAdhesionId], references: [id], onDelete: Restrict)

  reservations       ReservationMission[]
  preTripInspections PreTripInspection[] // ✅ NOUVELLE LIGNE

  // Traçabilité
  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt
  missionsFavoris MissionFavori[]

  @@index([userId])
  @@index([statut])
  @@index([estBloque])
  @@index([demandeAdhesionId])
  @@index([numeroAdherent])
  @@map("adherents")
}

// ==================== DOCUMENTS ====================

model Document {
  id Int @id @default(autoincrement())

  typeDocument TypeDocument
  numero       String?      @db.VarChar(100)

  dateDebutValidite DateTime? @db.Date
  dateFinValidite   DateTime? @db.Date

  statut StatutDocument?

  fichiers FichierDocument[]

  // Relations
  demandeAdhesionId Int?
  demandeAdhesion   DemandeAdhesion? @relation(fields: [demandeAdhesionId], references: [id], onDelete: Cascade)

  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: Cascade)

  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt

  @@index([demandeAdhesionId])
  @@index([missionId])
  @@index([typeDocument])
  @@map("documents")
}

model FichierDocument {
  id            Int    @id @default(autoincrement())
  cheminFichier String @db.VarChar(500)

  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt

  @@index([documentId])
  @@map("fichiers_documents")
}

// ==================== ADHÉRENTS ====================

//-------------------partenaire----------
model DemandePartenaire {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Informations de contact
  nom       String           @db.VarChar(100)
  entite    String           @db.VarChar(150)
  statut    StatutEntreprise
  telephone String           @db.VarChar(20)
  email     String           @db.VarChar(255)

  // Renseignements optionnels
  nombreDeplacements Int?
  nombreAgences      Int?

  // Statut de la demande
  statutDemande StatutDemande @default(EN_ATTENTE)

  codePartenaire String? @unique

  // Token pour création de profil
  profileToken       String?   @unique
  profileTokenExpiry DateTime?

  // Relations
  rendezvous Rendezvous?
  contrat    ContratPartenaire?

  // Lien 1‑1 vers le partenaire créé (profil complété)
  partenaireId Int?        @unique
  partenaire   Partenaire? @relation("DemandeToPartenaire", fields: [partenaireId], references: [id])

  // Notes internes
  notesInternes String? @db.Text

  @@index([email])
  @@index([statutDemande])
  @@index([createdAt])
  @@index([profileToken])
  @@index([statutDemande, createdAt])
  @@map("demandes_partenaire")
}

model Partenaire {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom          String @db.VarChar(100)
  prenom       String @db.VarChar(100)
  entiteGroupe String @db.VarChar(150)
  entiteAgence String @db.VarChar(150)
  email        String @unique @db.VarChar(255)
  telephone    String @db.VarChar(20)

  adresseAgence String? @db.VarChar(255)
  ville         String? @db.VarChar(100)
  logo          String? @db.VarChar(255)
  photoUrl      String? @db.VarChar(500)

  estActif Boolean @default(false)

  codePartenaire String? @unique

  profileToken          String?   @unique
  profileTokenExpiresAt DateTime?
  isProfileCompleted    Boolean   @default(false)

  demandeInitiale DemandePartenaire? @relation("DemandeToPartenaire")

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  missions Mission[] // ✅ relation inverse obligatoire même si optionnelle
  agences  Agence[]
  agents   Agent[]

  @@index([email])
  @@index([estActif])
  @@map("partenaires")
}

model Rendezvous {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Type et date
  typeRdv TypeRendezvous
  dateRdv DateTime       @db.Date
  creneau String         @db.VarChar(20)

  // Statut du rendez-vous
  statut StatutRendezvous @default(PLANIFIE)

  // Relations
  demandePartenaireId Int               @unique
  demandePartenaire   DemandePartenaire @relation(fields: [demandePartenaireId], references: [id], onDelete: Cascade)

  creneauReserveId Int?            @unique
  creneauReserve   CreneauReserve? @relation(fields: [creneauReserveId], references: [id])

  // Lien visio ou adresse
  lienVisio String? @db.VarChar(500)
  adresse   String? @db.VarChar(500)

  // Informations supplémentaires
  rappelEnvoye Boolean   @default(false)
  dateRappel   DateTime?

  // Notes de rendez-vous
  compteRendu String?             @db.Text
  resultat    ResultatRendezvous?

  @@index([dateRdv])
  @@index([statut])
  @@index([typeRdv])
  @@index([dateRdv, statut])
  @@map("rendezvous")
}

model CreneauReserve {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  // Date et créneau
  date    DateTime @db.Date
  creneau String   @db.VarChar(20)

  // Type de réservation
  type TypeReservation @default(RENDEZ_VOUS)

  // Relation optionnelle avec un rendez-vous
  rendezvous Rendezvous?

  // Pour les réservations personnalisées
  motif          String?   @db.VarChar(255)
  estActif       Boolean   @default(true)
  dateExpiration DateTime?

  @@unique([date, creneau])
  @@index([date])
  @@index([estActif])
  @@index([date, estActif])
  @@map("creneaux_reserves")
}

model DateIndisponible {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  date  DateTime @db.Date
  motif String   @db.VarChar(255)

  estActif Boolean @default(true)

  @@unique([date])
  @@index([date])
  @@index([estActif])
  @@index([date, estActif])
  @@map("dates_indisponibles")
}

model ContratPartenaire {
  id Int @id @default(autoincrement())

  // Dates du contrat
  dateCreation   DateTime @default(now())
  dateSignature  DateTime @db.Date
  dateFinContrat DateTime @db.Date

  // Stockage du document
  cheminDocument String @db.VarChar(500)
  nomFichier     String @db.VarChar(255)
  tailleDocument Int?

  // Tarification contractuelle ✅
  prixParKm               Float? // €/km
  depassementKilometrage  Float? // km autorisés avant surcoût
  retardSansAvertissement Float? // €/heure de retard non signalé
  restitutionAutreEndroit Float? // €/heure pour restitution hors lieu prévu

  // Relation avec la demande
  demandePartenaireId Int               @unique
  demandePartenaire   DemandePartenaire @relation(fields: [demandePartenaireId], references: [id], onDelete: Cascade)

  // Informations additionnelles
  estActif      Boolean @default(true)
  notesInternes String? @db.Text

  // Traçabilité
  updatedAt DateTime @updatedAt

  @@index([demandePartenaireId])
  @@index([dateFinContrat])
  @@index([estActif])
  @@map("contrats_partenaire")
}

// ============================================
// 📦 ENUMS
// ============================================

enum TypeVehicule {
  CITADINE
  BERLINE
  COMPACTE
  CABRIOLET
  MONOSPACE
  LUXE
  VU_3M3
  VU_6M3
  VU_9M3
  VU_12M3
  VU_15M3
  VU_20M3
  VU_25M3
  VU_30M3
}

enum TypeCarburant {
  ESSENCE
  DIESEL
  HYBRIDE
  ELECTRIQUE
}

enum BoiteVitesse {
  AUTOMATIQUE
  MANUELLE
}

enum TypeLieu {
  DOMICILE
  ENTREPRISE
  HOTEL
  GARE
  AEROPORT
  AGENCE // ✅ Ajouté
  CONCESSION // ✅ Ajouté
  PARTICULIER // ✅ Ajouté
  PARC_AUTO // ✅ Ajouté
  AUTRE
}

enum StatutMission {
  EN_ATTENTE // Créée par l'agent, visible pour les adhérents
  RESERVEE // Un adhérent a réservé
  RESERVATION_ANNULEE // Adhérent ou partenaire a annulé la réservation
  CONFIRMEE // Partenaire/agent a confirmé la réservation
  EN_COURS // Voiture en route
  TERMINEE // Mission complétée avec succès
  ARRIVEE // Voiture arrivée à destination
  PROBLEME_TRAJET // Déviation GPS ou problème détecté
}

enum TypeDocument {
  CARTE_IDENTITE
  PERMIS
  KBIS
  RIB
  RC_PRO
  RC_CIRCULATION
  CASIER_JUDICIAIRE
  W_GARAGE
  DOCUMENT_ADMINISTRATIF // ✅ Pour les documents mission
}

enum StatutDocument {
  VALIDE
  NON_VALIDE
  EN_ATTENTE
}

// ============================================
// 🚗 VEHICULE
// ============================================

// ✅ Après — relation sur agentId
model Vehicule {
  id              String        @id @default(cuid())
  typeVehicule    TypeVehicule
  typeCarburant   TypeCarburant
  marqueModele    String
  immatriculation String
  nombrePlaces    Int
  boiteVitesse    BoiteVitesse

  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt

  agentId  Int
  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  missions Mission[]

  @@index([agentId])
  @@index([immatriculation])
  @@map("vehicules")
}

// ============================================
// 📍 ADRESSE
// ============================================

model Adresse {
  id              String   @id @default(cuid())
  villeId         String
  villeNom        String
  adresseComplete String   @db.Text
  typeLieu        TypeLieu
  nomLieu         String?

  // Coordonnées GPS pour calcul distance
  latitude  Float
  longitude Float

  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt

  missionsDepart  Mission[] @relation("MissionDepart")
  missionsArrivee Mission[] @relation("MissionArrivee")

  @@index([villeId])
  @@map("adresses")
}

// ============================================
// 🎯 MISSION
// ============================================

model Mission {
  id          String        @id @default(uuid())
  statut      StatutMission @default(EN_ATTENTE)
  commentaire String?       @db.Text

  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt

  // ✅ Agent = responsable principal (obligatoire)
  agentId Int
  agent   Agent @relation(fields: [agentId], references: [id], onDelete: Restrict)

  // ✅ Partenaire = facturation uniquement (optionnel)
  partenaireId Int?
  partenaire   Partenaire? @relation(fields: [partenaireId], references: [id], onDelete: SetNull)

  // ✅ Agence (optionnel)
  agenceId Int?
  agence   Agence? @relation(fields: [agenceId], references: [id], onDelete: SetNull)

  // ✅ Véhicule
  vehiculeId String
  vehicule   Vehicule @relation(fields: [vehiculeId], references: [id])

  // ✅ Adresses
  adresseDepartId String
  adresseDepart   Adresse @relation("MissionDepart", fields: [adresseDepartId], references: [id])

  adresseArriveeId String
  adresseArrivee   Adresse @relation("MissionArrivee", fields: [adresseArriveeId], references: [id])

  // ✅ Relations enfants
  disponibilite DisponibiliteMission?
  notifications NotificationMission[]
  calculs       CalculMission?
  documents     Document[]
  reservations  ReservationMission[]
  completion    MissionCompletion?     // ✅ Résumé final
  sessions      MissionSession[]
  favoris MissionFavori[]   // ✅ ajouter uniquement cette ligne

  @@index([agentId])
  @@index([partenaireId])
  @@index([agenceId])
  @@index([vehiculeId])
  @@index([statut])
  @@map("missions")
}

model MissionFavori {
  adherentId Int
  missionId  String   // ✅ String car Mission.id est uuid()
  createdAt  DateTime @default(now())

  adherent Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)
  mission  Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@id([adherentId, missionId])  // ✅ clé composite, pas d'id séparé
  @@map("mission_favoris")
}

// ============================================
// ⏰ DISPONIBILITE
// ============================================

model DisponibiliteMission {
  id String @id @default(cuid())

  dateDebut     DateTime
  dateFin       DateTime
  dateDepartMax DateTime? // ✅ Date calculée automatiquement

  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId String  @unique

  @@index([dateDebut])
  @@map("disponibilites_mission")
}

// ============================================
// 🔔 NOTIFICATIONS
// ============================================

model NotificationMission {
  id               String  @id @default(cuid())
  typeNotification String // "DEPART" ou "ARRIVEE"
  actif            Boolean @default(false)

  // ✅ Ajout des contacts optionnels
  nomContact       String?
  telephoneContact String?

  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId String

  @@index([missionId])
  @@map("notifications_mission")
}

// ============================================
// 💰 CALCULS AUTOMATIQUES
// ============================================

model CalculMission {
  id String @id @default(cuid())

  distanceKm   Decimal @db.Decimal(10, 2)
  fraisPeage   Decimal @db.Decimal(10, 2)
  montantKm    Decimal @db.Decimal(10, 2) // ✅ distanceKm × prixParKm
  montantFinal Decimal @db.Decimal(10, 2) // ✅ montantKm + fraisPeage (arrondi)
  montantTotal Decimal @db.Decimal(10, 2) // ✅ gardé pour compatibilité (= montantFinal)

  detailCalcul Json?

  dateCalcul       DateTime @default(now())
  dateModification DateTime @updatedAt

  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId String  @unique

  @@index([missionId])
  @@map("calculs_mission")
}

model AlerteGeographique {
  id String @id @default(cuid())
  // Utilisateur
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Type d'alerte
  type TypeAlerte
  // Rayon commun aux 2 types
  rayon Int // en km
  // Type 1 : Géographique simple (1 ville)
  villeNom  String? @db.VarChar(255)
  latitude  Float?
  longitude Float?
  // Type 2 : Trajet (départ → arrivée)
  villeDepartNom  String? @db.VarChar(255)
  latitudeDepart  Float?
  longitudeDepart Float?
  villeArriveeNom  String? @db.VarChar(255)
  latitudeArrivee  Float?
  longitudeArrivee Float?
  dateDepart    DateTime?
  dateDepartMax DateTime?
  // État
  actif Boolean @default(true)
  // Canal de notification
  emailActif  Boolean  @default(false)
  pushActif   Boolean  @default(false)
  fcmToken    String?
  

  // Notifications envoyées
  notifications NotificationAlerte[]
  // Traçabilité
  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt
  @@index([userId, actif])
  @@index([type, actif])
  @@map("alertes_geographiques")
}

model NotificationAlerte {
  id String @id @default(cuid())
  alerteId String
  alerte   AlerteGeographique @relation(fields: [alerteId], references: [id], onDelete: Cascade)
  missionId String
  emailEnvoye Boolean  @default(false)
  pushEnvoye  Boolean  @default(false)
  dateEnvoi   DateTime?
  dateCreation DateTime @default(now())
  @@index([alerteId, missionId])
  @@map("notifications_alertes")
}

// ============================================
// 📋 RESERVATIONS DE MISSIONS
// ============================================

model ReservationMission {
  id String @id @default(cuid())

  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Restrict)

  adherentId Int
  adherent   Adherent @relation(fields: [adherentId], references: [id], onDelete: Restrict)

  statut            StatutReservation @default(EN_ATTENTE)
  numeroReservation String            @unique @db.VarChar(50)

  dateDepart  DateTime
  heureDepart String   @db.VarChar(5)

  dateArrivee  DateTime
  heureArrivee String   @db.VarChar(5)

  dureeEstimee Int?

  commentaireAdherent String? @db.Text
  commentaireAgent    String? @db.Text

  dateValidation DateTime?
  dateRefus      DateTime?
  motifRefus     String?   @db.Text

  montantTotal Decimal @db.Decimal(10, 2)
  fraisPeage   Decimal @db.Decimal(10, 2)
  distanceKm   Decimal @db.Decimal(10, 2)

  dateCreation             DateTime           @default(now())
  dateModification         DateTime           @updatedAt
  dateAcceptationAgent     DateTime?
  dateConfirmationAdherent DateTime?
  dateAnnulation           DateTime?
  motifAnnulation          String?            @db.Text
  annulePar                String? // "ADHERENT" | "AGENT"
  statutPrecedent          StatutReservation? // ✅ pour restauration après refus demande annulation

  preTripInspection PreTripInspection? // ✅ NOUVELLE LIGNE
missionSession MissionSession?

  @@index([missionId])
  @@index([adherentId])
  @@index([statut])
  @@index([dateDepart])
  @@index([numeroReservation])
  @@map("reservations_mission")
}

// ============================================
// 📋 FICHE TECHNIQUE DÉBUT DE MISSION (anti-fraude)
// ============================================

model PreTripInspection {
  id String @id @default(cuid())

  // Lien 1-1 avec la réservation (le convoyeur = adhérent qui a réservé)
  reservationId String             @unique
  reservation   ReservationMission @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  // Lien direct vers l'adhérent-convoyeur (facilite les requêtes)
  adherentId Int
  adherent   Adherent @relation(fields: [adherentId], references: [id], onDelete: Restrict)

  // Cycle de vie
  statut        StatutPreTripInspection @default(DRAFT)
  etapeCourante EtapeInspection         @default(EXTERIEUR)

  // Position GPS au démarrage et à la validation
  latitudeDebut  Float?
  longitudeDebut Float?
  latitudeFin    Float?
  longitudeFin   Float?

  // Timestamps métier
  dateDebut      DateTime  @default(now())
  dateValidation DateTime?

  // Motif si rejet automatique anti-fraude
  motifRejet String? @db.Text

  // Relations enfants
  medias  PreTripInspectionMedia[]
  consent PreTripConsent?

  // Traçabilité
  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt

  @@index([reservationId])
  @@index([adherentId])
  @@index([statut])
  @@map("pretrip_inspections")
}

model PreTripInspectionMedia {
  id String @id @default(cuid())

  inspectionId String
  inspection   PreTripInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  typeMedia TypeMediaInspection

  // Fichier
  cheminFichier String @db.VarChar(500)
  mimeType      String @db.VarChar(50)
  tailleFichier Int

  // Anti-fraude : empreinte SHA-256 du fichier
  hashSha256 String @db.VarChar(64)

  // Métadonnées EXIF extraites côté serveur
  latitude       Float
  longitude      Float
  precisionGps   Float?
  timestampPhoto DateTime // ⚠️ EXIF, pas date d'upload

  // Drapeau de validation anti-fraude
  validatedByServer Boolean @default(false)

  dateUpload       DateTime @default(now())
  dateModification DateTime @updatedAt

  @@unique([inspectionId, typeMedia]) // ⚠️ une seule photo par type
  @@index([inspectionId])
  @@index([typeMedia])
  @@index([hashSha256])
  @@map("pretrip_inspection_medias")
}

model PreTripConsent {
  id String @id @default(cuid())

  inspectionId String            @unique
  inspection   PreTripInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  // Version des CGU mission acceptées (audit légal)
  versionConditions String @default("v1.0") @db.VarChar(20)

  // Toutes les clauses individuelles + acceptation globale
  clausesAcceptees Json

  // Métadonnées juridiques
  dateAcceptation DateTime @default(now())
  ipAdresse       String?  @db.VarChar(45)
  userAgent       String?  @db.Text
  latitude        Float?
  longitude       Float?

  @@index([inspectionId])
  @@map("pretrip_consents")
}

model Agence {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nom        String  @db.VarChar(150)
  adresse    String? @db.VarChar(255)
  ville      String? @db.VarChar(100)
  codePostal String? @db.VarChar(20)
  telephone  String? @db.VarChar(20)
  email      String? @db.VarChar(255)
  isActive   Boolean @default(false)

  partenaireId Int
  partenaire   Partenaire @relation(fields: [partenaireId], references: [id], onDelete: Cascade)

  agents   Agent[]
  missions Mission[] // ✅ AJOUTER

  @@index([partenaireId])
  @@index([isActive])
  @@map("agences")
}

model Agent {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email     String  @unique @db.VarChar(255)
  password  String? @db.VarChar(255)
  nom       String? @db.VarChar(100)
  prenom    String? @db.VarChar(100)
  telephone String? @db.VarChar(20)
  photo     String? @db.VarChar(500)

  profileToken          String?   @unique @db.VarChar(255)
  profileTokenExpiresAt DateTime?
  isProfileCompleted    Boolean   @default(false)

  isActive Boolean @default(false)

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  agenceId Int?
  agence   Agence? @relation(fields: [agenceId], references: [id], onDelete: SetNull)

  partenaireId Int?
  partenaire   Partenaire? @relation(fields: [partenaireId], references: [id], onDelete: SetNull)

  vehicules Vehicule[] // ✅ déjà présent
  missions  Mission[] // ✅ relation inverse obligatoire

  @@index([email])
  @@index([isActive])
  @@index([agenceId])
  @@map("agents")
}

model HistoriqueAnnulation {
  id            String   @id @default(cuid())
  userId        Int
  mois          Int // 1-12
  annee         Int // ex: 2026
  nbAnnulations Int      @default(0)
  limite        Int      @default(5)
  dateCreation  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mois, annee])
  @@index([userId])
  @@map("historique_annulations")
}

// ============================================
// 📍 SUIVI GPS EN TEMPS RÉEL DURANT LA MISSION
// ============================================

model MissionGPSTrack {
  id String @id @default(cuid())

  // ── Relations ────────────────────────────
  sessionId String
  session   MissionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // ── Position GPS ─────────────────────────
  latitude  Float              // Latitude actuelle
  longitude Float              // Longitude actuelle
  accuracy  Float?             // Précision GPS en mètres
  altitude  Float?             // Altitude en mètres
  bearing   Float?             // Direction 0-360°
  speed     Float?             // Vitesse en km/h

  // ── Analyse déviation ────────────────────
  distanceFromRoute Float?     // Distance destination (m)
  isDeviated        Boolean @default(false)  // Sort de la zone ?

  // ── Traçabilité ──────────────────────────
  timestamp DateTime @default(now())

  @@index([sessionId])
  @@index([timestamp])
  @@index([isDeviated])
  @@map("mission_gps_tracks")
}

// ============================================
// 🏁 RÉSUMÉ FINAL DE MISSION
// ============================================

model MissionCompletion {
  id String @id @default(cuid())

  missionId String @unique
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // Position finale confirmée
  latitudeFin  Float
  longitudeFin Float

  // Statistiques de suivi
  totalLocations      Int       @default(0)
  validLocations      Int       @default(0)
  invalidLocations    Int       @default(0)
  maxDeviation        Float?    // écart GPS max détecté (m)
  dureeTrajet         Int?      // durée effective (secondes)

  // Statut
  completed    Boolean  @default(false)
  dateCompletion DateTime?

  // Raisons d'invalidation si applicable
  invalidationReason String? @db.Text

  dateCreation DateTime @default(now())

  // Relations
  medias MissionCompletionMedia[] // ✅ Photos finales post-mission

  @@index([missionId])
  @@map("mission_completions")
}

// ============================================
// 📸 MÉDIAS DE SESSION
// ============================================

model MissionSessionMedia {
  id String @id @default(cuid())

  // Relations
  sessionId String
  session   MissionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Type et catégorie
  etape        EtapeSession    // PRE_DEPART ou POST_LIVRAISON
  typeMedia    TypeMediaSession
  description  String?         @db.Text

  // Fichier
  cheminFichier String @db.VarChar(500)
  urlPublic     String? @db.VarChar(500)

  // Metadata
  tailleOctets  Int?
  typeContenu   String? @db.VarChar(50)

  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt

  @@index([sessionId])
  @@index([etape])
  @@index([typeMedia])
  @@unique([sessionId, etape, typeMedia])
  @@map("mission_session_medias")
}

// ============================================
// 📋 MISSION SESSION (Gestion complète)
// ============================================

model MissionSession {
  id String @id @default(cuid())

  // ── Relations existantes ─────────────────
  reservationId String             @unique
  reservation   ReservationMission @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // ── Consentement ─────────────────────────
  consentAccepted   Boolean  @default(false)
  dateConsentement  DateTime @default(now())

  // ── Démarrage ────────────────────────────
  latitudeDebut  Float
  longitudeDebut Float
  dateDebut      DateTime @default(now())

  // ── Fin de mission ────────────────────────
  latitudeFin       Float?
  longitudeFin      Float?
  dateFin           DateTime?
  kilometrageDebut  Int?
  kilometrageFin    Int?
  commentaireFin    String?  @db.Text

  // ✨ NOUVEAU : Signature du client
  signatureClient     String?         @db.Text    // SVG ou base64
  nomClientSignature  String?         @db.VarChar(100)
  dateSignatureClient DateTime?

  // ── Statut ────────────────────────────────
  statut StatutSession @default(EN_COURS)

  // ── Relations enfants ──────────────────────
  medias      MissionSessionMedia[]
  gpsHistory  MissionGPSTrack[]      // ✨ NOUVEAU
  incidents   MissionIncident[]       // ✨ NOUVEAU

  // ── Traçabilité ───────────────────────────
  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt

  @@index([reservationId])
  @@index([missionId])
  @@index([statut])
  @@map("mission_sessions")
}

// ============================================
// 🏁 MÉDIAS DE COMPLÉTION POST-MISSION
// ============================================

model MissionCompletionMedia {
  id String @id @default(cuid())

  // Relations
  completionId String
  completion   MissionCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)

  // Type de photo
  typeMedia    TypeMediaSession // Réutilise l'enum (PHOTO_*_FINAL, PREUVE_LIVRAISON, etc.)
  description  String?          @db.Text

  // Fichier
  cheminFichier String @db.VarChar(500)
  urlPublic     String? @db.VarChar(500)

  // Metadata
  tailleOctets  Int?
  typeContenu   String? @db.VarChar(50)

  // Traçabilité
  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt

  @@index([completionId])
  @@index([typeMedia])
  @@map("mission_completion_medias")
}

model MissionIncident {
  id String @id @default(cuid())

  // ── Relations ────────────────────────────
  sessionId String
  session   MissionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // ── Type incident ────────────────────────
  typeIncident IncidentType
  description  String @db.Text

  // ── Localisation ─────────────────────────
  latitude  Float
  longitude Float

  // ── Preuve ───────────────────────────────
  photoIncident String? @db.VarChar(500)  // Photo incident si prise

  // ── Résolution ───────────────────────────
  resolvedBy        String?
  resolutionNotes   String? @db.Text
  dateResolution    DateTime?

  // ── Traçabilité ──────────────────────────
  dateCreation DateTime @default(now())

  @@index([sessionId])
  @@index([typeIncident])
  @@index([dateCreation])
  @@map("mission_incidents")
}
